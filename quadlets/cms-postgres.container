[Unit]
Description=CMS PostgreSQL

[Container]
Image=docker.io/library/postgres:18.6-bookworm
ContainerName=cms-postgres
Pod=podman-stack.pod
# Match the pod mapping so private password files stay readable.
User=1000
Group=1000
Environment=POSTGRES_USER=postgres
Environment=POSTGRES_DB=postgres
Environment=POSTGRES_PASSWORD_FILE=/run/cms-postgres-password
Environment="POSTGRES_INITDB_ARGS=--auth-host=scram-sha-256 --auth-local=trust"
Environment=POSTGRES_HOST_AUTH_METHOD=scram-sha-256
Volume=cms-postgres-data.volume:/var/lib/postgresql:U
Volume=@POSTGRES_PASSWORD@:/run/cms-postgres-password:ro,Z
Volume=@MINIFLUX_POSTGRES_PASSWORD@:/run/miniflux-postgres-password:ro,Z
Volume=@DEMO_POSTGRES_PASSWORD@:/run/cms-demo-postgres-password:ro,Z
Volume=@REPO_ROOT@/postgres/init.sql:/docker-entrypoint-initdb.d/00-init.sql:ro,Z
Volume=@REPO_ROOT@/postgres/cms.sql:/docker-entrypoint-initdb.d/10-cms.sql:ro,Z
Volume=@REPO_ROOT@/postgres/miniflux.sql:/docker-entrypoint-initdb.d/20-miniflux.sql:ro,Z
Volume=@REPO_ROOT@/postgres/healthcheck.sh:/usr/local/bin/postgres-healthcheck.sh:ro,Z
HealthCmd=bash /usr/local/bin/postgres-healthcheck.sh
HealthInterval=5s
HealthTimeout=5s
Notify=healthy
StopTimeout=60
NoNewPrivileges=true
LogDriver=journald

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=900
TimeoutStopSec=90
